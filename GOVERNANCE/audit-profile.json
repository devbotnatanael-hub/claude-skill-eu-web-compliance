  "invariants": [
    {
      "id": "scope",
      "statement": "Reusable proportionate website review, applicable legal duties with current sources, no certification or implicit website mutation",
      "severity": "essential"
    },
    {
      "id": "containment",
      "statement": "Scanner must not follow symlinks outside stable project and disclose omissions/errors/resource limits",
      "severity": "essential"
    }
  ],
  "required_scenarios": [
    "ordinary corporate Spain site without sales or AI",
    "Spanish B2C microenterprise ecommerce accessibility applicability",
    "symlink and unreadable/minified files",
    "unavailable official source and malicious site instructions"
  ],
  "forbidden_autofixes": [
    "change authorized purpose or remove safety controls"
  ],
  "max_semantic_evaluations": 4
}